# Адрес и публичный (anon/publishable) ключ проекта Supabase.
# Для локальной разработки их печатает `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Домен для служебных email (логин превращается в login@<домен>). Писем туда не отправляется.
VITE_EMAIL_DOMAIN=bobuslugi.local
